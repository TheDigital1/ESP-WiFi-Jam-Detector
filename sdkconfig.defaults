# esp-wifi-jammer-detector, Waveshare ESP32-C5-Touch-LCD-3.5.
CONFIG_IDF_TARGET="esp32c5"

# Flash: 32 MB (esptool flash_id), DIO 80 MHz as in Waveshare's demos.
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Same base settings as esp-sdr's sdkconfig.defaults.esp32c5.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# CONFIG_PM_ENABLE is not set

# Receiver: same radio settings as esp-sdr's sdkconfig.defaults(.esp32c5).
# The cert-test PHY library provides phy_stop_tx_tone() and the private RX
# hooks the receiver uses; nothing here enables any transmit path.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
CONFIG_ESP_PHY_DEBUG=y
# Leave enough non-modem SRAM for static data and task stacks.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_EXTRA_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# CONFIG_ESP_WIFI_SLP_IRAM_OPT is not set
# CONFIG_ESP_PHY_IRAM_OPT is not set
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set

# PSRAM: LVGL and DSP buffers live here; internal SRAM is reserved for the
# capture bank and Wi-Fi/PHY (see components/espsdr_rx).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# SPI ISR may run from flash: saves IRAM, and lets the LCD transfer-done
# callback call into LVGL (main/lvgl_port.c).
# CONFIG_SPI_MASTER_ISR_IN_IRAM is not set
CONFIG_SPIRAM_SPEED_80M=y

# LVGL 9.5 (main/lvgl_port.c provides the PSRAM allocator).
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_NONE=y
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
